# ==========================================
# CONFIGURACIÓN WHATSAPP CLOUD API & AGENTE
# ==========================================

# Credenciales de Meta for Developers (WhatsApp Cloud API)
WHATSAPP_ACCESS_TOKEN=tu_whatsapp_access_token_aqui
PHONE_NUMBER_ID=tu_phone_number_id_aqui
WABA_TOKEN_ID=tu_waba_id_opcional
VERIFY_TOKEN=cupcakes_webhook_secret_2026

# Versión de Graph API de Meta
WHATSAPP_API_VERSION=v21.0

# Configuración del Servidor Web
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Configuración del Proveedor LLM
# Opciones: 'auto', 'ollama', 'groq', 'openai', 'fallback'
# 'auto': prueba Ollama -> Groq/OpenAI -> Fallback inteligente
LLM_PROVIDER=auto

# Configuración Ollama (si se usa localmente)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Configuración APIs en la Nube (Opcional)
GROQ_API_KEY=
OPENAI_API_KEY=

# Configuración ngrok (Opcional, para exponer webhook a internet)
NGROK_AUTHTOKEN=

# Base de datos
DATABASE_PATH=data/cupcakes.db
